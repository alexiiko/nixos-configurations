{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "external_directory": "ask",
    "skill": {
      "*": "deny",
      "caveman-commit": "allow",
      "caveman-compress": "allow",
      "investigate-first": "allow",
      "safe-refactor": "allow",
      "surgical-patch": "allow",
      "verify-and-stop": "allow",
      "pdf": "allow",
      "docx": "allow",
      "xlsx": "allow",
      "pptx": "allow"
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": ["uv", "tool", "run", "--from", "headroom-ai", "--with", "mcp<2", "python", "-m", "headroom.ccr.mcp_server"],
      "enabled": true
    },
    "ai-memory": {
      "type": "remote",
      "url": "http://127.0.0.1:49374/mcp",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  }
}

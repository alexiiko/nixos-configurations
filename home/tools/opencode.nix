{
  # opencode config + notify plugin. The ai-memory plugin and the
  # package.json/node_modules stay out of nix on purpose: they are
  # auto-generated by `ai-memory install-hooks --agent opencode --apply`.
  xdg.configFile."opencode/opencode.jsonc" = {
    force = true;
    source = ./opencode/opencode.jsonc;
  };
  xdg.configFile."opencode/plugins/notify.ts" = {
    force = true;
    source = ./opencode/plugins/notify.ts;
  };
}
